generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ CORE ============
model Inquilino {
  id               String   @id @default(cuid())
  nome             String
  email            String   @unique
  telefone         String?
  cpfCnpj          String   @unique // criptografado em repouso via app-layer
  cpfCnpjHash      String   @unique // hash para busca
  senhaHash        String
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?  // TOTP secret criptografado
  ativo            Boolean  @default(true)
  endereco         String?
  // Medidores exclusivos por tipo
  medidorEnergia        String?
  codigoMedidorEnergia  String?  @unique
  tipoCobrancaEnergia   String?  @default("COMPARTILHADA") // RATIO | COMPARTILHADA | PORCENTAGEM
  porcentagemEnergia    Decimal?
  medidorAgua           String?
  codigoMedidorAgua     String?  @unique
  tipoCobrancaAgua      String?  @default("COMPARTILHADA")
  porcentagemAgua       Decimal?
  medidorGas            String?
  codigoMedidorGas      String?  @unique
  tipoCobrancaGas       String?  @default("COMPARTILHADA")
  porcentagemGas        Decimal?
  // legado (manter compatibilidade)
  medidor          String?  // nº do medidor físico
  codigoMedidor    String?  @unique // gerador MED-XXXX
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unidades         UnidadeInquilino[]
  sessoes          Sessao[]
  notificacoes     Notificacao[]
  contestacoes     Contestacao[]
  chamados         Chamado[]
  comprovantes     ComprovantePix[]
}

model Unidade {
  id               String   @id @default(cuid())
  bloco            String?
  numero           String
  identificacao    String   @unique // ex: BL-A-101
  tipo             String   @default("APARTAMENTO")
  fracaoIdeal      Decimal? @default(1.0) // para rateio RATIO
  createdAt        DateTime @default(now())

  inquilinos       UnidadeInquilino[]
  administradores  AdministradorUnidade[]
  leituras         Leitura[]
  faturas          Fatura[]
  rateios          CondominioRateio[]
}

model UnidadeInquilino {
  id          String   @id @default(cuid())
  inquilinoId String
  unidadeId   String
  contratoId  String?  @unique
  papel       String   @default("TITULAR") // TITULAR | DEPENDENTE
  createdAt   DateTime @default(now())

  inquilino   Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  unidade     Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  contrato    Contrato? @relation(fields: [contratoId], references: [id])

  @@unique([inquilinoId, unidadeId])
}

model Contrato {
  id          String   @id @default(cuid())
  numero      String   @unique
  inicio      DateTime
  fim         DateTime?
  valor       Decimal?
  createdAt   DateTime @default(now())

  vinculo     UnidadeInquilino?
}

// ============ LEITURAS ============
model Leitura {
  id               String      @id @default(cuid())
  unidadeId        String
  tipo             String
  referencia       String      // YYYY-MM
  leituraAnterior  Float
  leituraAtual     Float
  consumo          Float       // kWh ou m³
  tarifa           Decimal?    // R$/kWh ou R$/m³
  bandeira         String?
  dataLeitura      DateTime
  leituristaId     String?
  leituristaNome   String?
  createdAt        DateTime    @default(now())

  unidade          Unidade     @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, tipo, referencia])
  @@index([unidadeId, tipo])
}

// ============ LEITURISTA ============
model Leiturista {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique // login
  senhaHash  String
  telefone   String?
  regiao     String?
  matricula  String?  @unique
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ FATURAS ============
model Fatura {
  id               String       @id @default(cuid())
  unidadeId        String
  tipo             String
  referencia       String       // YYYY-MM
  valorTotal       Decimal
  rateioValor      Decimal?
  criterioRateio   String?
  dataEmissao      DateTime
  dataVencimento   DateTime
  dataPagamento    DateTime?
  status           String @default("ABERTA")
  codigoBarras     String?
  linhaDigitavel   String?
  // PIX
  pixTxId          String?      @unique
  pixQrCode        String?      // payload copia e cola
  pixQrImage       String?      // base64 ou url
  // Demonstrativo (proprietário controla para AGUA/GAS/ENERGIA)
  valorDemonstrativo   Decimal?
  descricaoDemonstrativo String?
  exibirDemonstrativo  Boolean @default(true) // AGUA/GAS/ENERGIA toggle; CONDOMINIO sempre true
  createdAt        DateTime     @default(now())

  unidade          Unidade      @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  contestacoes     Contestacao[]
  comprovantes     ComprovantePix[]

  @@index([unidadeId, referencia])
}

model ComprovantePix {
  id          String   @id @default(cuid())
  faturaId    String
  inquilinoId String
  arquivoUrl  String
  valor       Decimal?
  createdAt   DateTime @default(now())

  fatura      Fatura   @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  inquilino   Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
}

// ============ CONTESTACAO ============
model Contestacao {
  id          String                @id @default(cuid())
  faturaId    String?
  inquilinoId String
  categoria   String
  motivo      String
  status      String     @default("ABERTO")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  fatura      Fatura?   @relation(fields: [faturaId], references: [id])
  inquilino   Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  anexos      Anexo[]
  mensagens   MensagemContestacao[]
}

model Anexo {
  id            String      @id @default(cuid())
  contestacaoId String
  url           String
  nome          String
  tipo          String?
  createdAt     DateTime    @default(now())
  contestacao   Contestacao @relation(fields: [contestacaoId], references: [id], onDelete: Cascade)
}

model MensagemContestacao {
  id            String      @id @default(cuid())
  contestacaoId String
  autorTipo     String      // INQUILINO | ATENDENTE | SISTEMA
  autorId       String?
  texto         String
  createdAt     DateTime    @default(now())
  contestacao   Contestacao @relation(fields: [contestacaoId], references: [id], onDelete: Cascade)
}

// ============ ATENDIMENTO ============
model Chamado {
  id          String           @id @default(cuid())
  inquilinoId String
  categoria   String
  assunto     String
  status      String    @default("ABERTO")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  inquilino   Inquilino        @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  mensagens   MensagemChat[]
}

model MensagemChat {
  id        String   @id @default(cuid())
  chamadoId String
  autorTipo String   // INQUILINO | ATENDENTE | SISTEMA
  autorId   String?
  texto     String
  createdAt DateTime @default(now())
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
}

// ============ NOTIFICACOES ============
model Notificacao {
  id          String          @id @default(cuid())
  inquilinoId String
  tipo        String
  canal       String @default("SISTEMA")
  titulo      String
  mensagem    String
  lida        Boolean         @default(false)
  createdAt   DateTime        @default(now())
  inquilino   Inquilino       @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
}

// ============ ADMIN MASTER / ADMINISTRADORES / PROPRIETARIOS ============
model Administrador {
  id              String    @id @default(cuid())
  nome            String
  email           String    @unique
  senhaHash       String
  papel           String    @default("ADMINISTRADOR") // MASTER | ADMINISTRADOR | PROPRIETARIO
  telefone        String?
  documento       String?   @unique // CPF/CNPJ
  ativo           Boolean   @default(true)
  // Comercial: controle de contrato por perfil
  plano           String?   @default("TRIAL") // TRIAL | SEMESTRAL | ANUAL | DIAS
  diasContrato    Int?      // usado quando plano=DIAS ou TRIAL custom
  contratoInicio  DateTime?
  dataExpiracao   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  unidades        AdministradorUnidade[]
  sessoes         SessaoAdmin[]
  pixConfigs      PixConfig[]
}

model AdministradorUnidade {
  id              String        @id @default(cuid())
  administradorId String
  unidadeId       String
  createdAt       DateTime      @default(now())
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)
  unidade         Unidade       @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  @@unique([administradorId, unidadeId])
}

// ============ CONDOMÍNIO - CUSTOS E RATEIO ============
model CondominioDespesa {
  id              String   @id @default(cuid())
  referencia      String   // YYYY-MM
  categoria       String   // AGUA | GAS | ENERGIA | OUTROS
  especificacao   String?  // ex: Internet, Manutenção, Segurança eletrônica (quando OUTROS)
  empresa         String?  // prestador / empresa
  valor           Decimal
  data            DateTime
  vencimento      DateTime
  codFatura       String?  // código da fatura/empresa
  descricao       String?
  tipoCobranca    String   @default("COMPARTILHADA") // RATIO | COMPARTILHADA | PORCENTAGEM
  porcentagem     Decimal? // ex: 12.5 quando PORCENTAGEM
  createdAt       DateTime @default(now())
  rateios         CondominioRateio[]
  @@index([referencia])
}

model CondominioRateio {
  id           String   @id @default(cuid())
  despesaId    String
  unidadeId    String
  valorRateio  Decimal
  criterio     String?
  createdAt    DateTime @default(now())
  despesa      CondominioDespesa @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  unidade      Unidade           @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  @@unique([despesaId, unidadeId])
}

// ============ PIX CONFIG - BCB (real, por proprietário) ============
model PixConfig {
  id            String   @id @default(cuid())
  // vínculo opcional por proprietário/admin ou global
  administradorId String?
  tipoChave     String   // CPF | CNPJ | EMAIL | TELEFONE | ALEATORIA
  chave         String   @unique // chave PIX real conforme BCB
  banco         String?  // ex: 001 Banco do Brasil, 104 Caixa
  agencia       String?
  conta         String?
  titularNome   String
  titularCidade String   @default("SAO PAULO")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  administrador Administrador? @relation(fields: [administradorId], references: [id], onDelete: SetNull)
}

// ============ SESSAO ============
model Sessao {
  id           String   @id @default(cuid())
  inquilinoId  String
  refreshToken String   @unique // hash
  userAgent    String?
  ip           String?
  expiraEm     DateTime
  revogada     Boolean  @default(false)
  createdAt    DateTime @default(now())
  inquilino    Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
}

model SessaoAdmin {
  id              String   @id @default(cuid())
  administradorId String
  refreshToken    String   @unique
  expiraEm        DateTime
  revogada        Boolean  @default(false)
  createdAt       DateTime @default(now())
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)
}
