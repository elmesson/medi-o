{
  "name": "elmesson-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Elmesson - App Android Inquilino (Capacitor + FCM + OCR)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.23.1",
    "@capacitor/core": "5.7.0",
    "@capacitor/android": "5.7.0",
    "@capacitor/camera": "5.0.8",
    "@capacitor/push-notifications": "5.1.0",
    "@capacitor/app": "5.0.8",
    "@capacitor/preferences": "5.0.8",
    "@capacitor/filesystem": "5.2.0"
  },
  "devDependencies": {
    "typescript": "5.5.3",
    "@capacitor/cli": "5.7.0",
    "vite": "5.4.0",
    "@vitejs/plugin-react": "4.3.1"
  }
}
