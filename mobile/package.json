{
  "name": "elmesson-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Elmesson - App Android Inquilino (Capacitor + FCM + OCR)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "cap:init": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "5.7.0",
    "@capacitor/app": "5.0.8",
    "@capacitor/camera": "5.0.8",
    "@capacitor/core": "5.7.0",
    "@capacitor/filesystem": "5.2.0",
    "@capacitor/preferences": "5.0.8",
    "@capacitor/push-notifications": "5.1.0",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.23.1"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "vite": "5.4.0"
  }
}
